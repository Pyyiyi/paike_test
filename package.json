{
  "name": "paike",
  "version": "0.1.0",
  "private": true,
  "description": "智能排课系统 V1.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:backend": "tsx watch backend/src/main.ts",
    "dev:frontend": "vite --config vite.config.ts",
    "start": "node dist/main.js",
    "build": "npm run build:backend && npm run build:frontend",
    "build:backend": "tsc -p tsconfig.build.json",
    "build:frontend": "vue-tsc -p frontend/tsconfig.json --noEmit && vite build --config vite.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && vue-tsc -p frontend/tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:migrate": "tsx backend/src/scripts/migrate.ts",
    "db:seed": "tsx backend/src/scripts/seed.ts",
    "contracts:lint": "npx --yes @redocly/cli@latest lint contracts/openapi.yaml",
    "contracts:validate": "python3 contracts/validate.py",
    "contracts:check": "npm run contracts:lint && npm run contracts:validate"
  },
  "dependencies": {
    "argon2": "^0.41.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.7",
    "element-plus": "^2.14.7",
    "express": "^4.21.2",
    "express-session": "^1.19.0",
    "fast-glob": "^3.3.3",
    "pg": "^8.13.1",
    "pinia": "^2.3.1",
    "vue": "^3.5.44",
    "vue-router": "^4.6.4",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.64.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.19.0",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.2",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/test-utils": "^2.5.1",
    "concurrently": "^9.2.5",
    "eslint": "^9.17.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-vue": "^9.33.0",
    "globals": "^15.14.0",
    "happy-dom": "^16.8.1",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.1",
    "vite": "^6.4.4",
    "vitest": "^2.1.8",
    "vue-eslint-parser": "^9.4.3",
    "vue-tsc": "^2.2.12"
  }
}
